# Copy to functions/.env and fill in before deploying.
#
# The Play Console package the subscription belongs to. Every purchase token is
# verified against THIS package: a token minted for anything else is rejected,
# and so is an RTDN whose payload names a different package. It is never taken
# from a client, so a repackaged APK cannot point verification somewhere else.
# Must equal the app's applicationId (app.config.ts / EXPO_PUBLIC_ANDROID_PACKAGE).
GOOGLE_PLAY_PACKAGE_NAME=app.revora.android.dev

# Pub/Sub topic that Google Play publishes Real-time Developer Notifications to.
# Must match the topic entered in Play Console → Monetise → Monetisation setup.
GOOGLE_PLAY_RTDN_TOPIC=revora-google-play

# Which model answers Pro assistant questions (OpenRouter model id).
ASSISTANT_MODEL=google/gemini-2.5-flash-lite
