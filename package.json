{
  "name": "revora",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "prebuild": "expo prebuild --clean",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "test:rules": "firebase emulators:exec --only firestore --project revora-rules-test \"jest --config jest.rules.config.js\"",
    "test:functions": "npm --prefix functions test",
    "test:billing": "firebase emulators:exec --only firestore --project revora-rules-test \"npm --prefix functions run test:integration\""
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/auth": "^26.3.3",
    "@react-native-firebase/firestore": "^26.3.3",
    "@react-native-firebase/storage": "^26.3.3",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.18",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.15",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^16.5.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "firebase-tools": "^15.28.2",
    "jest": "~29.7.0",
    "jest-expo": "^57.0.5",
    "sharp": "^0.35.4",
    "typescript": "~6.0.3"
  }
}
