# Revora — build-time configuration.
#
# Nothing here is a secret. Firebase client identifiers are public by design:
# they identify the project, they do not authorise access. Every access decision
# is made server-side by firestore.rules and storage.rules.
#
# Real secrets (service accounts, API keys for server-side services, signing
# keys) must never appear in this file or anywhere else in the app bundle —
# anything shipped in an APK is readable.

# Android application id. Must match google-services.json.
EXPO_PUBLIC_ANDROID_PACKAGE=app.revora.android.dev

# Path to the Google services file, if it lives outside the repo (EAS secret).
# GOOGLE_SERVICES_JSON=./google-services.json

# EAS project id, for `eas build`.
# EAS_PROJECT_ID=

# Set to "development" to build the side-by-side dev variant.
# APP_VARIANT=development
